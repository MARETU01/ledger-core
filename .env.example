# Project-local compose.yml. These are disposable development credentials.
POSTGRES_URL=jdbc:postgresql://localhost:15432/ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_dev
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_USERNAME=
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=
NACOS_SERVER_ADDR=localhost:18848
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=
NACOS_GROUP=LEDGER_GROUP
SERVICE_IP=127.0.0.1

# Optional Go gateway. Run Go commands from gateway/ after exporting this file.
GATEWAY_LISTEN_ADDR=127.0.0.1:8080
GATEWAY_ROUTES_SOURCE=file
GATEWAY_ROUTES_FILE=config/routes.yml
GATEWAY_NACOS_DATA_ID=gateway-routes.yml
GATEWAY_DESCRIPTOR_DIR=.
GATEWAY_STATIC_TARGETS=
GATEWAY_API_TOKEN=
GATEWAY_GRPC_TLS=false

# Java startup and Nacos connection settings. dev runtime settings are local.
# For test/prod, publish config/nacos/*.yml before starting the Java services.
# Go gateway settings are in gateway/config/config.yaml.
SPRING_PROFILES_ACTIVE=dev
NACOS_SERVER_ADDR=localhost:8848
NACOS_USERNAME=
NACOS_PASSWORD=
# Optional override; defaults to ledger-dev / ledger-test / ledger-prod by profile.
# NACOS_NAMESPACE=ledger-dev
NACOS_GROUP=LEDGER_GROUP
SERVICE_IP=127.0.0.1
